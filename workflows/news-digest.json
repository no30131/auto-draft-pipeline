      "id": "c0000000-0000-0000-0000-000000000004",
      "name": "清理標題"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 加入你想排除的來源（付費牆、不適合引用的媒體等）\nconst blockedSources = [\n  'SOURCE_A',\n  'SOURCE_B'\n];\n\nconst kept = [];\n\nfor (const item of items) {\n  const title = item.json.title || '';\n  const link = item.json.link || '';\n\n  const isBlockedSource = blockedSources.some(source =>\n    title.includes(source) || link.includes(source)\n  );\n  if (isBlockedSource) continue;\n\n  let isDuplicate = false;\n  for (const keptItem of kept) {\n    const keptTitle = keptItem.json.title || '';\n    let found = false;\n    for (let i = 0; i <= title.length - 10; i++) {\n      const sub = title.substring(i, i + 10);\n      if (keptTitle.includes(sub)) {\n        found = true;\n        break;\n      }\n    }\n    if (found) { isDuplicate = true; break; }\n  }\n\n  if (!isDuplicate) kept.push(item);\n}\n\nreturn kept;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [592, 400],
      "id": "c0000000-0000-0000-0000-000000000005",
      "name": "排除重複與黑名單"
    },
