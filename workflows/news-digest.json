    {
      "parameters": {
        "jsCode": "const results = $json.organic_results || [];\nlet realUrl = $('保存標題連結').item.json.origLink;\n\nif (results.length > 0) {\n  const first = results[0];\n  if (first.link\n    && !first.link.includes('news.google.com')\n    && !first.link.includes('vertexaisearch')) {\n    realUrl = first.link;\n  }\n}\n\nreturn [{\n  json: {\n    origTitle: $('保存標題連結').item.json.origTitle,\n    origLink: $('保存標題連結').item.json.origLink,\n    origSnippet: $('保存標題連結').item.json.origSnippet,\n    realUrl: realUrl\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1264, 400],
